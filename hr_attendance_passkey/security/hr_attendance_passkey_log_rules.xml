<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_hr_attendance_passkey_log_manager" model="ir.rule">
            <field name="name">Passkey Logs - Managers</field>
            <field name="model_id" ref="model_hr_attendance_passkey_log"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="domain_force">[(0, '=', 0)]</field>
        </record>

        <record id="rule_hr_attendance_passkey_log_hr" model="ir.rule">
            <field name="name">Passkey Logs - HR Officers</field>
            <field name="model_id" ref="model_hr_attendance_passkey_log"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="rule_hr_attendance_passkey_log_employee_self" model="ir.rule">
            <field name="name">Passkey Logs - Employee Self</field>
            <field name="model_id" ref="model_hr_attendance_passkey_log"/>
            <field name="domain_force">[(0, '=', 1)]</field>
        </record>
    </data>
</odoo>
