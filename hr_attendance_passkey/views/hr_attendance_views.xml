<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_attendance_passkey_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form.passkey.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_passkey_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history">
                    <field name="passkey_log_count" widget="statinfo" string="Authentication Logs"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='check_in']" position="after">
                <field name="check_in_method" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
